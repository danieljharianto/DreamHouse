# Copy this file to .env and fill in your own values.
# .env is gitignored -- it will never be committed.

# Path to the Blender executable used by the server and dev scripts.
BLENDER_PATH=C:\Users\YOUR_USER\.cache\dreamhouse\blender\blender-4.5.4-windows-x64\blender.exe

# Local eval server URL used by the dev scripts (dev_run.py, run_baselines.py).
DREAMHOUSE_SERVER=http://127.0.0.1:8000

# Required only for examples/claude_agent.py.
ANTHROPIC_API_KEY=xxx

# Optional overrides for examples/claude_agent.py.
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_MAX_TOKENS=8000
